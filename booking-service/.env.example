DATABASE_URL=postgresql://booking-service_owner:REDACTED@ep-plain-voice-a54om4ip.us-east-2.aws.neon.tech/booking-service?sslmode=require
MATCHING_SERVICE_URL=http://localhost:8001
NOTIFY_SERVICE_URL=http://localhost:8002


# Signs auth tokens. Must be set in every real environment: if it is
# missing the service generates a random key at startup, which means
# tokens do not survive a restart and are not valid across replicas.
AUTH_SECRET_KEY=change-me-to-a-long-random-string

# Origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000
